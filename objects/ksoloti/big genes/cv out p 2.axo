<objdefs appVersion="1.0.12">
   <obj.normal id="cv out p 2" uuid="78c39cf4-581b-4230-88f9-4d663f4fca4f">
      <sDescription>Low-speed 12 bit digital to analog conversion, not suitable for audio signals, but for control voltages.
To be used with Ksoloti Big Genes. Two outputs.
Unipolar input (0...64). Suitable for unipolar LFOs, envelopes, etc.
NOT for creating 1V/oct pitch CV.</sDescription>
      <author>Johannes Taelman, Ksoloti</author>
      <license>BSD</license>
	   <helpPatch>cv out big genes.axh</helpPatch>
      <inlets>
         <frac32.positive name="cv1"/>
         <frac32.positive name="cv2"/>
      </inlets>
      <outlets/>
      <displays/>
      <params/>
      <attribs>
         <combo name="offset">
            <MenuEntries>
               <string>E4 (0) = 0V (Axoloti)</string>
               <string>C4 (-4) = 0V (Eurorack)</string>
            </MenuEntries>
            <CEntries>
               <string>0</string>
               <string>(1&lt;&lt;22)</string>
            </CEntries>
         </combo>
         <combo name="when_stopped" description="&lt;html&gt;Which value should the CV rest at whenever the patch is stopped.&lt;br&gt;&apos;deinit&apos; means the DAC is stopped and the GPIO settings are cleared.">
            <MenuEntries>
               <string>center</string>
               <string>low</string>
               <string>high</string>
               <string>deinit</string>
            </MenuEntries>
            <CEntries>
               <string>0</string>
               <string>1</string>
               <string>2</string>
               <string>3</string>
            </CEntries>
         </combo>
      </attribs>
      <code.declaration><![CDATA[int calc_cv_unipolar(int in, int offs) {
	int val = (1<<27) - in + offs;
	return __USAT(val, 27);
}]]></code.declaration>
      <code.init><![CDATA[palSetPadMode(GPIOA, 4, PAL_MODE_OUTPUT_OPENDRAIN);
palSetPadMode(GPIOA, 5, PAL_MODE_OUTPUT_OPENDRAIN);
RCC->APB1ENR |= 0x20000000;
DAC->CR |= 0x00010001;]]></code.init>
      <code.dispose><![CDATA[#if attr_when__stopped == 0
/* CV rests at center when patch is stopped */
DAC->DHR12R1 = 0x800; /* 2048, half of 12-bit max 4095 */
DAC->DHR12R2 = 0x800;
#elif attr_when__stopped == 1
/* CV rests at low when patch is stopped */
DAC->DHR12R1 = 0xFFF; /* Big Genes outputs invert the signal */
DAC->DHR12R2 = 0xFFF;
#elif attr_when__stopped == 2
/* CV rests at high when patch is stopped */
DAC->DHR12R1 = 0; /* Big Genes outputs invert the signal */
DAC->DHR12R2 = 0;
#elif attr_when__stopped == 3
/* Deinit: stop DAC and clear GPIO (CV will likely go high or low!) */
DAC->CR = 0x0;
RCC->APB1ENR &= ~0x20000000;
palSetPadMode(GPIOA, 4, PAL_MODE_INPUT_ANALOG);
palSetPadMode(GPIOA, 5, PAL_MODE_INPUT_ANALOG);
#endif]]></code.dispose>
      <code.krate><![CDATA[DAC->DHR12R1 = calc_cv_unipolar(inlet_cv1, attr_offset)>>15;
DAC->DHR12R2 = calc_cv_unipolar(inlet_cv2, attr_offset)>>15;]]></code.krate>
   </obj.normal>
</objdefs>